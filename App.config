<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    ============================================================================
    Üretim Doküman Senkronizasyonu - AYARLAR
    Bu dosya derlenmiş uygulamanın yanında "ProductionDocumentationSync.exe.config"
    adıyla durur. Değişiklik için yeniden derleme gerekmez; uygulamayı yeniden
    başlatmak yeterlidir.
    ============================================================================
  -->
  <appSettings>
    <!-- Kopyalanan PDF ve Excel dosyalarının kök klasörü. Altında Proje\Klasör\Operasyon klasörleri oluşur. -->
    <add key="TargetRoot" value="D:\GebzeUretim" />

    <!-- Excel şablonu (Antet.xlsx). Boş bırakılırsa TargetRoot\Antet.xlsx kullanılır. -->
    <add key="TemplateXlsx" value="" />

    <!-- Çalışma günlükleri (Run_*.log ve Run_*.xlsx). Boş bırakılırsa TargetRoot\_Raporlar kullanılır. -->
    <add key="LogDir" value="" />

    <!-- SOLIDWORKS PDM kasa adı -->
    <add key="PdmVault" value="BERRMAK" />

    <!-- /auto modunda bugünden kaç gün geriye bakılsın (0 = yalnızca bugün). Görev bir gün atlarsa 1 yapılabilir. -->
    <add key="AutoLookbackDays" value="0" />

    <!-- /auto modunda azami çalışma süresi (dakika). Aşılırsa uygulama kendini kapatır (çıkış kodu 3). 0 = sınırsız. -->
    <add key="AutoTimeoutMinutes" value="120" />
  </appSettings>

  <connectionStrings>
    <!-- SAP Business One veritabanı -->
    <add name="Sap"
         connectionString="Server=192.168.10.15;Database=berrmakprod1;User Id=armada;Password=Armada1234*;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.6.0" newVersion="4.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
